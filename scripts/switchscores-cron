# Cron jobs for Switch Scores
#
# Each line runs a group of jobs from config/cron-groups.php through cron:group (#185), in its
# own 30-minute slot. cron:group records every step in job_runs, so the staff home's Nightly
# jobs tile and /staff/cron-health show each job, not just the group (#164). Cron health reads
# this file and the groups, so a new job only needs a line in its group.
# Times are UTC.
# Not installed by deploy.sh: after changing it, run
#   sudo install -m 644 -o root -g root scripts/switchscores-cron /etc/cron.d/switchscores-cron

0 3 * * * www-data cd /var/www/switchscores.com && php artisan cron:group steam >/dev/null 2>&1
30 3 * * * www-data cd /var/www/switchscores.com && php artisan cron:group nintendo-import >/dev/null 2>&1
0 4 * * * www-data cd /var/www/switchscores.com && php artisan cron:group nintendo-process >/dev/null 2>&1
30 4 * * * www-data cd /var/www/switchscores.com && php artisan cron:group reviews-import >/dev/null 2>&1
0 5 * * * www-data cd /var/www/switchscores.com && php artisan cron:group reviews-drafts >/dev/null 2>&1
30 5 * * * www-data cd /var/www/switchscores.com && php artisan cron:group games >/dev/null 2>&1
0 6 * * * www-data cd /var/www/switchscores.com && php artisan cron:group site >/dev/null 2>&1
30 6 * * * www-data cd /var/www/switchscores.com && php artisan cron:group crawl >/dev/null 2>&1
