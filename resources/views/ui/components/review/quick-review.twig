{% macro render(review, withTitles=false, version='b5') %}
    {% import 'ui/components/rating/badge.twig' as rating %}

    {% if withTitles %}
        <div class="row quick-reviews-title">
            <div class="col-md-12">
                <a href="{{ game_url(review.game) }}">
                    {{ review.game.title }}
                </a>
            </div>
        </div>
    {% endif %}

    <div class="row quick-reviews-header">
        <div class="col-md-4 col-sm-4 col-xs-4">
            {{ review.created_at|date('jS M Y') }}
        </div>
        <div class="col-md-6 col-sm-6 col-xs-6">
            {{ review.user.display_name }}
        </div>
        <div class="col-md-2 col-sm-2 col-xs-2">
            {{ rating.score(review.review_score, 'h6', version) }}
        </div>
    </div>

    <div class="row quick-reviews-body">
        <div class="col-md-12">
            {{ review.review_body|raw }}
        </div>
    </div>
{% endmacro %}

{# Members dashboard: leads with the game, and has no date as the reviews are in random order #}
{% macro renderMemberPanel(review) %}
    {% import 'ui/components/game/packshots.twig' as packshots %}
    {% import 'ui/components/rating/badge.twig' as rating %}

    <div class="member-review">
        <div class="member-review-packshot">
            {{ packshots.square(review.game) }}
        </div>
        <div class="member-review-content">
            <div class="member-review-band">
                <a class="member-review-title" href="{{ game_url(review.game) }}">{{ review.game.title }}</a>
                <span class="member-review-score">{{ rating.score(review.review_score, 'h6') }}</span>
            </div>
            <div class="member-review-body">
                {{ review.review_body|raw }}
            </div>
            <div class="member-review-by">Reviewed by: {{ review.user.display_name }}</div>
        </div>
    </div>
{% endmacro %}
