{# width and height reserve the space while lazy images load; the CSS sets the displayed size #}
{% macro header(item, lazy = true) %}
    {% import 'ui/components/image/resolve.twig' as image %}
    {% set boxartUrl = image.header(item)|trim %}
    <a href="{{ game_url(item) }}">
        {% if boxartUrl %}
            <img src="{{ boxartUrl }}" width="1920" height="1080"{% if lazy %} loading="lazy"{% endif %} class="img-responsive" style="border: 0; width: 100%;" alt="{{ item.title }}">
        {% else %}
            <img src="/img/placeholder/no-image-found-wide.png" class="img-responsive" style="border: 0; width: 100%;" alt="{{ item.title }}">
        {% endif %}
    </a>
{% endmacro %}

{% macro square(item, tabindex = null) %}
    {% import 'ui/components/image/resolve.twig' as image %}
    {% set boxartUrl = image.square(item)|trim %}
    <a href="{{ game_url(item) }}"{% if tabindex is not null %} tabindex="{{ tabindex }}"{% endif %}>
        {% if boxartUrl %}
            <img src="{{ boxartUrl }}" width="500" height="500" loading="lazy" class="img-responsive" style="border: 0; width: 100%;" alt="{{ item.title }}">
        {% else %}
            <img src="/img/placeholder/no-image-found-square.png" class="img-responsive" style="border: 0; width: 100%;" alt="{{ item.title }}">
        {% endif %}
    </a>
{% endmacro %}

{% macro squareReleaseHub(item) %}
    {% import 'ui/components/image/resolve.twig' as image %}
    {% set boxartUrl = image.square(item)|trim %}
    <a href="{{ game_url(item) }}">
        {% if boxartUrl %}
            <img src="{{ boxartUrl }}" width="500" height="500" loading="lazy" class="img-thumbnail me-2 align-middle" style="border: 0; width: 60px; height: auto;" alt="{{ item.title }}">
        {% else %}
            <img src="/img/placeholder/no-image-found-square.png" class="img-thumbnail me-2 align-middle" style="border: 0; width: 60px; height: auto;" alt="{{ item.title }}">
        {% endif %}
    </a>
{% endmacro %}

{% macro squareImageOnly(item) %}
    {% import 'ui/components/image/resolve.twig' as image %}
    {% set boxartUrl = image.square(item)|trim %}
    {% if boxartUrl %}
        <img src="{{ boxartUrl }}" width="500" height="500" loading="lazy" class="img-responsive" style="border: 0; width: 100%;" alt="{{ item.title }}">
    {% else %}
        <img src="/img/placeholder/no-image-found-square.png" class="img-responsive" style="border: 0; width: 100%;" alt="{{ item.title }}">
    {% endif %}
{% endmacro %}
