{% extends 'theme/wos/base.twig' %}

{% block page_body %}

<div class="row">

    {# The login form comes first in the markup so returning members reach it first on a phone. On desktop it moves to the right-hand column. #}
    <div class="col-md-6 col-md-push-6">

        <h2>Log in</h2>

        {% if errors.any %}
            {% for error in errors.all %}
                <p>{{ error }}</p>
            {% endfor %}
        {% endif %}
        <form class="form-horizontal" role="form" method="POST" action="{{ route('login') }}">
            {{ csrf_field() }}

            <div class="form-group">
                <div class="col-md-8 text-left">
                    <label for="email" class="control-label">Email address</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-6">
                    <input id="email" type="email" class="form-control" name="email" value="{{ old('email') }}" required autofocus autocomplete="email">
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-8 text-left">
                    <label for="password" class="control-label">Password</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-6">
                    <input id="password" type="password" class="form-control" name="password" required autocomplete="current-password">
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-8 text-left">
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="remember" {{ old('remember') ? 'checked' : '' }}> Remember me
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-8 text-left">
                    <button type="submit" class="btn btn-primary">
                        Log in
                    </button>
                </div>
            </div>
        </form>

        <p>
            <a href="{{ route('password.request') }}">Forgotten your password?</a>
        </p>
        <p class="text-muted">
            <small>Have an older account linked to Twitter? <a href="{{ route('auth.login.twitter') }}">Log in with Twitter</a></small>
        </p>

    </div>

    <div class="col-md-6 col-md-pull-6">

        <h2>New here? Join Switch Scores today:</h2>

        {% include 'auth/join-reasons.twig' %}

        <a class="btn btn-primary" href="{{ route('register') }}">Create an account</a>

    </div>

</div>

{% endblock page_body %}
