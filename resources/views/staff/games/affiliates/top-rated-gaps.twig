{% extends 'theme/staff-b5/layout-default.twig' %}

{% import 'ui/components/links/game.twig' as gamelink %}

{% block page_inner %}

<div class="row">
    <div class="col-md-4">
        <table class="table">
            <tbody>
                <tr>
                    <th>Page</th>
                    <td>
                        {% if PagePath %}
                            <a href="{{ PagePath }}" target="_blank" rel="noopener">{{ PagePath }}</a>
                        {% else %}
                            Not on a Top rated page
                        {% endif %}
                    </td>
                </tr>
                {% if PagePath %}
                <tr>
                    <th>Search clicks</th>
                    <td>
                        {% if PageStats.clicks is null %}
                            No data in the latest snapshot
                        {% else %}
                            {{ PageStats.clicks }} in {{ PageStats.windowDays }} days to {{ PageStats.snapshotDate }}
                        {% endif %}
                    </td>
                </tr>
                {% endif %}
                <tr>
                    <th>Gaps</th>
                    <td><span id="gap-count">{{ GapRows|length }}</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

{% if IsRated8Plus %}
<p>Active ranked games rated 8 or more that aren't in any Top 100, with no direct {{ RegionName }} link and an Unchecked status. Their buy buttons only show on their own game pages. Rank is the overall rank. A game leaves the list once it's saved or marked Not found.</p>
{% else %}
<p>Ranked games with no direct {{ RegionName }} link and an Unchecked status. A game leaves the list once it's saved or marked Not found.</p>
{% endif %}

{% if GapRows|length %}
    <table class="table align-middle">
        <thead>
            <tr>
                <th class="text-end">Rank</th>
                <th>Game</th>
                <th>Physical</th>
                <th style="min-width: 300px;">{{ RegionName }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for row in GapRows %}
                <tr class="js-gap-row" data-save-url="{{ route('staff.games.affiliates.quickSave', {'gameId': row.game.id}) }}"
                    {% if Region == 'us' %}data-match-url="{{ route('staff.games.affiliates.findMatch', {'gameId': row.game.id}) }}"{% endif %}>
                    <td class="text-end">{{ row.game.page_rank }}</td>
                    <td>{{ gamelink.title(row.game, 'staff') }}</td>
                    <td>{{ row.game.format_physical }}</td>
                    <td class="align-top">
                        <div class="input-group input-group-sm">
                            {% if Region == 'us' %}
                                <button type="button" class="btn btn-outline-primary js-find-match">Find match</button>
                            {% endif %}
                            <a class="btn btn-outline-secondary" href="{{ row.searchUrl }}" target="_blank" rel="noopener">Search</a>
                            <input type="text" class="form-control js-asin"
                                   placeholder="Paste URL" aria-label="{{ RegionName }} URL or ASIN for {{ row.game.title }}">
                        </div>
                        <div class="small text-danger js-message"></div>
                        {# No margin while empty, so the column lines up with the Save buttons. Width 0 with
                           min-width 100% keeps long product titles from widening the column: they wrap instead. #}
                        <div class="js-matches" style="width: 0; min-width: 100%;"></div>
                    </td>
                    <td class="align-top">
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-primary btn-sm js-save">Save</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm js-not-found">Not found</button>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p>No gaps found!</p>
{% endif %}

<script>
    $(function () {
        var csrfToken = $('meta[name="csrf-token"]').attr('content');
        var region = '{{ Region }}';

        function save($row, data) {
            var $controls = $row.find('input, button');
            var $message = $row.find('.js-message');

            if ($row.data('saving')) {
                return;
            }
            $row.data('saving', true);
            $controls.prop('disabled', true);
            $message.text('');

            $.ajax({
                url: $row.data('save-url'),
                method: 'POST',
                data: $.extend({region: region}, data),
                headers: {'X-CSRF-TOKEN': csrfToken}
            }).done(function () {
                $row.remove();
                $('#gap-count').text($('.js-gap-row').length);
            }).fail(function (xhr) {
                var response = xhr.responseJSON;
                $message.text(response && response.error ? response.error : 'Could not save. Please try again.');
                $controls.prop('disabled', false);
            }).always(function () {
                $row.data('saving', false);
            });
        }

        function saveAsin($row) {
            save($row, {asin: $row.find('.js-asin').val().trim()});
        }

        $(document).on('click', '.js-save', function () {
            saveAsin($(this).closest('.js-gap-row'));
        });

        $(document).on('keydown', '.js-asin', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                saveAsin($(this).closest('.js-gap-row'));
            }
        });

        $(document).on('click', '.js-not-found', function () {
            save($(this).closest('.js-gap-row'), {no_product: 1});
        });

        {% if Region == 'us' %}
        // Find match: one Amazon US search, shown for picking. Built with .text() so product
        // titles from Amazon can't inject markup.
        function renderMatches($row, results) {
            var $matches = $('<div class="mt-2">').appendTo($row.find('.js-matches').empty());

            if (!results.length) {
                $matches.append($('<div class="small text-muted">').text('No matches found.'));
                return;
            }

            $.each(results, function (i, result) {
                var $item = $('<div class="d-flex align-items-center gap-2 border-top py-1">');

                if (result.imageUrl) {
                    $item.append($('<img alt="" width="40" style="height: auto; flex-shrink: 0;">').attr('src', result.imageUrl));
                }

                var $text = $('<div class="small flex-grow-1 text-break" style="min-width: 0;">');
                $text.append($('<div>').text(result.title || result.asin));
                var details = [result.brand, result.price, result.asin].filter(Boolean).join(' · ');
                $text.append($('<div class="text-muted">').text(details));
                if (result.consoleWarning) {
                    $text.append($('<span class="badge bg-warning text-dark">').text('Title says ' + result.consoleWarning));
                }
                $item.append($text);

                $item.append($('<a class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">')
                    .attr('href', result.viewUrl).text('View'));
                $item.append($('<button type="button" class="btn btn-primary btn-sm js-use-match">')
                    .attr('data-asin', result.asin).text('Use this'));

                $matches.append($item);
            });
        }

        $(document).on('click', '.js-find-match', function () {
            var $button = $(this);
            var $row = $button.closest('.js-gap-row');
            var $message = $row.find('.js-message');

            $button.prop('disabled', true);
            $message.text('');
            $row.find('.js-matches').empty().append($('<div class="small text-muted mt-2">').text('Searching Amazon US...'));

            $.getJSON($row.data('match-url')).done(function (response) {
                renderMatches($row, response.results || []);
            }).fail(function (xhr) {
                var response = xhr.responseJSON;
                $row.find('.js-matches').empty();
                $message.text(response && response.error ? response.error : 'Could not search Amazon. Please try again.');
            }).always(function () {
                $button.prop('disabled', false);
            });
        });

        $(document).on('click', '.js-use-match', function () {
            var $row = $(this).closest('.js-gap-row');
            $row.find('.js-asin').val($(this).attr('data-asin'));
            saveAsin($row);
        });
        {% endif %}
    });
</script>

{% endblock page_inner %}
