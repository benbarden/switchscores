{% extends 'theme/staff-b5/layout-default.twig' %}

{% block page_inner %}

<div class="mb-3">
    <a href="{{ route('staff.games.weekly-updates.index') }}" class="btn btn-secondary btn-sm">&larr; Back to weekly updates</a>
</div>

<p class="text-muted" style="max-width: 760px;">
    Titles edited by hand in the weekly update, next to what the title cleanup produced.
    This is the list to review when tuning the title cleanup rules.
</p>

{% if Items|length > 0 %}
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Batch</th>
                <th>Console</th>
                <th>From the paste</th>
                <th>Auto title</th>
                <th>Edited to</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        {% for item in Items %}
            <tr>
                <td style="white-space: nowrap;">
                    <a href="{{ route('staff.games.weekly-updates.show', {'batchId': item.batch_id}) }}">{{ item.batch ? item.batch.batch_date|date('d M Y') : item.batch_id }}</a>
                </td>
                <td style="white-space: nowrap;">{{ item.console }}</td>
                <td>{{ item.title_raw }}</td>
                <td>{{ item.title_auto }}</td>
                <td><strong>{{ item.title }}</strong></td>
                <td style="white-space: nowrap;">
                    {% if item.game_id and item.isImported() %}
                        <a href="{{ route('staff.games.detail', {'gameId': item.game_id}) }}">Imported</a>
                    {% else %}
                        {{ item.item_status }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    <p>No titles have been edited yet.</p>
{% endif %}

{% endblock page_inner %}
