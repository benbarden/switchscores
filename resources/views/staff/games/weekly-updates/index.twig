{% extends 'theme/staff-b5/layout-default.twig' %}

{% block page_inner %}

<div class="mb-3">
    <a href="{{ route('staff.games.weekly-updates.create') }}" class="btn btn-primary">New batch</a>
    <a href="{{ route('staff.games.weekly-updates.exclusions.index') }}" class="btn btn-outline-secondary btn-sm ms-2">Manage exclusions</a>
</div>

{% if Batches.count > 0 %}
    <style>
        /* One line per batch: the counts are the content, the labels are in the header */
        #batch-list td, #batch-list th { padding: 0.4rem 0.5rem; vertical-align: middle; }
        #batch-list .count { font-size: 1.05rem; font-weight: 600; line-height: 1.1; }
    </style>

    <table class="table table-striped table-hover" id="batch-list" style="max-width: 900px;">
        <thead>
            <tr>
                <th style="width: 15%;">Date</th>
                <th style="width: 13%;">Status</th>
                <th class="text-center" style="width: 12%;">S2 New</th>
                <th class="text-center" style="width: 12%;">S2 Upcoming</th>
                <th class="text-center" style="width: 12%;">S1 New</th>
                <th class="text-center" style="width: 12%;">S1 Upcoming</th>
                <th class="text-center" style="width: 12%;">Excluded</th>
            </tr>
        </thead>
        <tbody>
        {% for batch in Batches %}
            <tr>
                <td><a href="{{ route('staff.games.weekly-updates.show', {'batchId': batch.id}) }}">{{ batch.batch_date|date('d M Y') }}</a></td>
                {% set c = AllCounts[batch.id] ?? {} %}
                {% set totalImported = 0 %}
                {% set totalPending = 0 %}
                {% for con in ['switch-2', 'switch-1'] %}
                    {% for lt in ['new', 'upcoming'] %}
                        {% set lc2 = c[con][lt] ?? {} %}
                        {% set totalImported = totalImported + (lc2['imported'] ?? 0) %}
                        {% set totalPending = totalPending + (lc2['pending'] ?? 0) + (lc2['fetch_pending'] ?? 0) + (lc2['lq_review'] ?? 0) + (lc2['packshot_pending'] ?? 0) + (lc2['category_pending'] ?? 0) + (lc2['ready'] ?? 0) %}
                    {% endfor %}
                {% endfor %}
                <td>
                    {% if totalImported > 0 and totalPending == 0 %}
                        <span class="badge bg-success">Complete</span>
                    {% elseif totalImported > 0 or totalPending > 0 %}
                        <span class="badge bg-primary">In progress</span>
                    {% else %}
                        <span class="badge bg-secondary">Setup</span>
                    {% endif %}
                </td>
                {% set totalExcluded = 0 %}
                {% for console in ['switch-2', 'switch-1'] %}
                    {% for listType in ['new', 'upcoming'] %}
                        {% set lc = c[console][listType] ?? {} %}
                        {% set imported = lc['imported'] ?? 0 %}
                        {% set ready = lc['ready'] ?? 0 %}
                        {% set totalExcluded = totalExcluded
                            + (lc['low_quality'] ?? 0) + (lc['bundle'] ?? 0) + (lc['excluded'] ?? 0) %}
                        <td class="text-center">
                            {% if imported > 0 %}
                                <span class="count text-success">{{ imported }}</span>
                            {% else %}
                                <span class="count text-muted">—</span>
                            {% endif %}
                            {# Only while a batch is still being worked #}
                            {% if ready > 0 %}
                                <br><span class="small text-primary">{{ ready }} ready</span>
                            {% endif %}
                        </td>
                    {% endfor %}
                {% endfor %}
                <td class="text-center">
                    {% if totalExcluded > 0 %}
                        <span class="count text-muted">{{ totalExcluded }}</span>
                    {% else %}
                        <span class="count text-muted">—</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ Batches.links()|raw }}
{% else %}
    <p class="text-muted">No weekly batches yet.</p>
{% endif %}

{% endblock page_inner %}
