{% extends 'theme/staff-b5/layout-default.twig' %}

{% block page_inner %}

{% include 'staff/games/weekly-updates/list/_stage-nav.twig' %}

{% if session('success') %}
    <div class="alert alert-success">{{ session('success') }}</div>
{% endif %}
{% if session('error') %}
    <div class="alert alert-danger">{{ session('error') }}</div>
{% endif %}
{% if session('warning') %}
    <div class="alert alert-warning">{{ session('warning') }}</div>
{% endif %}

<div class="row mb-3">
    <div class="col">
        <p class="mb-1">
            <strong>Date range:</strong>
            {% if ListType == 'new' %}
                New releases: {{ DateFrom }} – {{ DateTo }}
            {% else %}
                Upcoming: {{ DateFrom }} onwards
            {% endif %}
        </p>
    </div>
</div>

{# ---- Pages already uploaded ---- #}
{% if RawPages|length > 0 %}
    <h2>Pages uploaded</h2>
    {# Upcoming lists can have games with no exact date ("2027"), which can't be imported yet #}
    {% set showNotAdded = ListType != 'new' %}
    <table class="table table-sm table-bordered table-striped" style="max-width: 900px;">
        <thead class="table-dark">
            <tr>
                <th>Page</th>
                <th>Status</th>
                <th class="text-center">Total</th>
                <th class="text-center">LQ</th>
                <th class="text-center">Bundle</th>
                <th class="text-center">Excluded</th>
                <th class="text-center">Already in DB</th>
                {% if showNotAdded %}<th class="text-center">No exact date</th>{% endif %}
                <th class="text-center">In progress</th>
                <th class="text-center">Imported</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for page in RawPages %}
            {% set pc = PageCounts[page.page_number] ?? {} %}
            <tr>
                <td>Page {{ page.page_number }}</td>
                <td>
                    {% if page.isParsed() %}
                        <span class="badge bg-success">Parsed</span>
                    {% else %}
                        <span class="badge bg-secondary">Not parsed</span>
                    {% endif %}
                </td>
                <td class="text-center">
                    {% set total = pc['total'] ?? 0 %}
                    {# The last page is usually short, so only flag the others (#193) #}
                    {% if page.isParsed() and total != ExpectedPageSize and not loop.last %}
                        <span class="badge bg-warning text-dark" title="Nintendo pages normally have {{ ExpectedPageSize }} games. A different total may mean a partial paste.">{{ total }} ⚠</span>
                    {% else %}
                        <span class="fw-semibold">{{ total }}</span>
                    {% endif %}
                </td>
                {% for key in ['low_quality', 'bundle', 'excluded', 'already_in_db']|merge(showNotAdded ? ['not_added'] : [])|merge(['in_progress']) %}
                    <td class="text-center">{{ pc[key] ?? 0 }}</td>
                {% endfor %}
                <td class="text-center">
                    {% if (pc['imported'] ?? 0) > 0 %}
                        <span class="text-success fw-semibold">{{ pc['imported'] }}</span>
                    {% else %}
                        0
                    {% endif %}
                </td>
                <td>
                    <form method="post" action="{{ route('staff.games.weekly-updates.list.raw.remove-page', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}" class="d-inline" onsubmit="return confirm('Remove page {{ page.page_number }} and all its parsed items?')">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="page_number" value="{{ page.page_number }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

{# ---- Add / replace page ---- #}
<h2 class="mt-4">{{ RawPages|length > 0 ? 'Add another page' : 'Add page 1' }}</h2>

<form method="post" action="{{ route('staff.games.weekly-updates.list.raw.save-page', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}">
    {{ csrf_field()|raw }}
    <input type="hidden" name="page_number" value="{{ NextPageNumber }}">

    <div class="mb-3" style="max-width: 700px;">
        <label class="form-label">Paste Nintendo listing data for page {{ NextPageNumber }}</label>
        <textarea name="raw_content" class="form-control font-monospace" rows="20" placeholder="Paste raw Nintendo listing data here..."></textarea>
        <input type="hidden" name="raw_html" value="">
        <div class="form-text raw-html-status" data-default="Tip: copy the game tiles directly from the Nintendo store to also capture URLs, packshots and NSUIDs.">Tip: copy the game tiles directly from the Nintendo store to also capture URLs, packshots and NSUIDs.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save and parse page {{ NextPageNumber }}</button>
</form>

{# ---- Replace existing page ---- #}
{% if RawPages|length > 0 %}
<details class="mt-4">
    <summary class="text-muted" style="cursor: pointer;">Replace an existing page</summary>
    <div class="mt-3">
        {% for page in RawPages %}
        <h2>Replace page {{ page.page_number }}</h2>
        <form method="post" action="{{ route('staff.games.weekly-updates.list.raw.save-page', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}" class="mb-3">
            {{ csrf_field()|raw }}
            <input type="hidden" name="page_number" value="{{ page.page_number }}">
            <div class="mb-2" style="max-width: 700px;">
                <textarea name="raw_content" class="form-control font-monospace" rows="8" placeholder="Paste replacement content for page {{ page.page_number }}..."></textarea>
                <input type="hidden" name="raw_html" value="">
                <div class="form-text raw-html-status" data-default="Paste from the Nintendo store to capture URLs, packshots and NSUIDs.">Paste from the Nintendo store to capture URLs, packshots and NSUIDs.</div>
            </div>
            <button type="submit" class="btn btn-sm btn-warning">Replace page {{ page.page_number }}</button>
        </form>
        {% endfor %}
    </div>
</details>
{% endif %}

{# ---- Parsed items summary ---- #}
{% if Items|length > 0 %}
    <hr class="mt-4">
    <h2>Parsed items</h2>

    <div class="mb-3">
        <span class="badge bg-primary">{{ Counts['pending'] ?? 0 }} to process</span>
        <span class="badge bg-secondary ms-1">{{ InDbCount }} already in DB</span>
        {% if NotAddedItems|length > 0 %}
            <span class="badge bg-light text-dark border ms-1">{{ NotAddedItems|length }} no exact date</span>
        {% endif %}
        {% if (Counts['low_quality'] ?? 0) > 0 %}
            <span class="badge bg-warning text-dark ms-1">{{ Counts['low_quality'] }} LQ signalled</span>
        {% endif %}
        {% if (Counts['bundle'] ?? 0) > 0 %}
            <span class="badge bg-info text-dark ms-1">{{ Counts['bundle'] }} bundles</span>
        {% endif %}
    </div>

    {% set activeItems = Items|filter(i => i.item_status not in ['out_of_range', 'already_in_db']) %}

    {% if activeItems|length > 0 %}
    <table class="table table-sm table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th class="text-center">Page</th>
                <th>Title</th>
                <th class="text-center">Date</th>
                <th class="text-center">Price</th>
                <th>Genres</th>
                <th>Status</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="active-items-body">
        {% for item in activeItems %}
            {% include 'staff/games/weekly-updates/list/_active-item-row.twig' with {'item': item} %}
        {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {# ---- No exact date (Upcoming): can't be imported until the store gives a full date ---- #}
    {% if NotAddedItems|length > 0 %}
    <h3 class="mt-4">No exact date ({{ NotAddedItems|length }})</h3>
    <p class="text-muted small mb-2">Not added to this batch. They come in when the store gives a full release date.</p>
    <table class="table table-sm table-bordered text-muted" style="max-width: 800px;">
        <thead class="table-dark">
            <tr>
                <th class="text-center" style="width: 6%;">Page</th>
                <th>Title</th>
                <th style="width: 30%;">Reason</th>
            </tr>
        </thead>
        <tbody>
        {% for item in NotAddedItems %}
            <tr>
                <td class="text-center">{{ item.page_number }}</td>
                <td>{{ item.title_raw }}</td>
                <td>
                    {% if item.release_date %}
                        Released {{ item.release_date|date('d M Y') }}
                    {% else %}
                        No exact date{% if item.release_date_raw %}: {{ item.release_date_raw }}{% endif %}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {# ---- Already in DB: one row per page, expanding to list the games ---- #}
    {% if InDbCount > 0 %}
    <h3 class="mt-4">Already in DB ({{ InDbCount }})</h3>
    <table class="table table-sm table-bordered text-muted" style="max-width: 700px;">
        <thead class="table-dark">
            <tr>
                <th class="text-center" style="width: 10%;">Page</th>
                <th>Games</th>
            </tr>
        </thead>
        <tbody>
        {% for pageNum, pageItems in InDbByPage %}
            <tr>
                <td class="text-center">{{ pageNum }}</td>
                <td>
                    <details>
                        <summary style="cursor: pointer;">{{ pageItems|length }} game{{ pageItems|length != 1 ? 's' : '' }}</summary>
                        <table class="table table-sm mb-0 mt-2">
                            <tbody>
                            {% for item in pageItems %}
                                <tr>
                                    <td>{{ item.title_raw }}</td>
                                    <td class="text-end" style="white-space: nowrap; width: 20%;">{{ item.release_date ? item.release_date|date('d M Y') : '—' }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </details>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}

{% endif %}

{% if RawPages|length > 0 %}
<div class="mt-4">
    <a href="{{ route('staff.games.weekly-updates.list.urls', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}" class="btn btn-success">Continue to URL collection →</a>
</div>
{% endif %}

{% endblock page_inner %}

{% block page_body %}
{{ parent() }}
<script>
(function () {
    const CSRF_TOKEN = '{{ csrf_token() }}';

    const ACTION_BADGE = {
        'bundle':        '<span class="badge bg-info text-dark">Bundle</span>',
        'excluded':      '<span class="badge bg-secondary">Excluded</span>',
        'low_quality':   '<span class="badge bg-danger">LQ</span>',
        'pending':       '<span class="badge bg-primary">To process</span>',
        'fetch_pending': '<span class="badge bg-primary">To process</span>',
    };

    // ---- Rich-HTML paste capture ----
    // When staff paste game tiles copied from the Nintendo store, the clipboard
    // carries a text/html representation with store URLs, packshot URLs and NSUIDs.
    // A plain textarea keeps only the plain text, so we grab the HTML on paste and
    // stash it in a hidden field. The visible textarea still shows readable text.
    document.querySelectorAll('form textarea[name="raw_content"]').forEach(function (textarea) {
        var form   = textarea.closest('form');
        var hidden = form.querySelector('input[name="raw_html"]');
        var status = form.querySelector('.raw-html-status');
        if (!hidden) return;

        var justPasted = false;

        // Same rows as HtmlListParser counts (#210): games far ahead can have no NSUID,
        // so rows are found by their title attribute as well
        function countRows(html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            return doc.querySelectorAll('li[data-nsuid], li[data-nt-item-title], li[data-nt-item-title-master]').length;
        }

        function looksLikeStoreHtml(html) {
            return html && html.indexOf('<li') !== -1
                && (html.indexOf('data-nsuid') !== -1 || html.indexOf('data-nt-item-title') !== -1);
        }

        textarea.addEventListener('paste', function (e) {
            var html = (e.clipboardData || window.clipboardData).getData('text/html');
            if (looksLikeStoreHtml(html)) {
                hidden.value = html;
                justPasted = true;
                if (status) {
                    var n = countRows(html);
                    status.textContent = '✓ Captured rich HTML — ' + n + ' game' + (n === 1 ? '' : 's') + ' with URLs and packshots.';
                    status.classList.add('text-success');
                }
            } else {
                // Pasted content isn't store HTML — fall back to plain-text parsing.
                hidden.value = '';
                if (status) { status.textContent = status.dataset.default; status.classList.remove('text-success'); }
            }
        });

        // If the box is edited by hand after a paste, the captured HTML no longer
        // matches what's visible, so discard it and parse the plain text instead.
        textarea.addEventListener('input', function () {
            if (justPasted) { justPasted = false; return; }
            if (hidden.value) {
                hidden.value = '';
                if (status) { status.textContent = status.dataset.default; status.classList.remove('text-success'); }
            }
        });
    });

    function bindItemAction(select) {
        select.addEventListener('change', function () {
            const action = select.value;
            if (!action) return;

            const url = select.dataset.actionUrl;
            const row = select.closest('tr');

            // Re-parse needs a full reload since it changes the title text
            if (action === 'reparse') {
                select.disabled = true;
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': CSRF_TOKEN,
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'action=reparse',
                }).then(function () { window.location.reload(); });
                return;
            }

            select.disabled = true;

            fetch(url, {
                method: 'POST',
                headers: {
                    'X-CSRF-TOKEN': CSRF_TOKEN,
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'action=' + encodeURIComponent(action),
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.status === 'ok') {
                    const newStatus = data.new_status;
                    const statusCell = row.querySelector('.status-cell');
                    if (statusCell && ACTION_BADGE[newStatus]) {
                        statusCell.innerHTML = ACTION_BADGE[newStatus];
                    }
                    if (['bundle', 'excluded', 'low_quality'].includes(newStatus)) {
                        row.style.opacity = '0.5';
                        select.remove();
                    } else {
                        select.value = '';
                        select.disabled = false;
                    }
                } else {
                    select.value = '';
                    select.disabled = false;
                }
            })
            .catch(function () {
                select.value = '';
                select.disabled = false;
            });
        });
    }

    document.querySelectorAll('.item-action-select').forEach(bindItemAction);
})();
</script>
{% include 'staff/games/weekly-updates/list/_title-edit-script.twig' %}
{% endblock page_body %}
