{% extends 'theme/staff-b5/layout-default.twig' %}

{% block page_inner %}

{% include 'staff/games/weekly-updates/list/_stage-nav.twig' %}

{% if session('success') %}
    <div class="alert alert-success">{{ session('success') }}</div>
{% endif %}
{% if session('error') %}
    <div class="alert alert-danger">{{ session('error') }}</div>
{% endif %}

{% if Publishers|length == 0 %}
    <p class="text-muted">No publishers found — fetch some games first.</p>
{% else %}

{% set newPublishers      = Publishers|filter(p => p.status == 'new') %}
{% set existingPublishers = Publishers|filter(p => p.status != 'new') %}
{% set newCount           = newPublishers|length %}

{% if newCount > 0 %}
<div class="alert alert-warning mb-3">
    <strong>{{ newCount }} new publisher{{ newCount != 1 ? 's' : '' }} need{{ newCount == 1 ? 's' : '' }} to be resolved</strong> before importing.
    For each one, link it to an existing publisher (adding the name as an alias if it's another form of theirs), or save it as a new publisher.
</div>

<h2 class="mb-2">New publishers</h2>
<table class="table table-sm table-bordered mb-4">
    <thead class="table-dark">
        <tr>
            <th style="width: 25%;">Publisher</th>
            <th style="width: 7%;" class="text-center">This batch</th>
            <th>Link to an existing publisher</th>
            <th style="width: 20%;">Or save as new</th>
        </tr>
    </thead>
    <tbody>
    {% for pub in newPublishers %}
        <tr class="publisher-row" data-name="{{ pub.name }}" data-status="{{ pub.status }}">
            <td class="align-middle publisher-name-cell">
                <input type="text" class="form-control form-control-sm pub-name-input" value="{{ pub.name }}">
                {% if pub.sample_nintendo_url %}
                    <a href="{{ pub.sample_nintendo_url }}" target="_blank" class="small text-muted">Sample game link (Nintendo.com) ↗</a>
                {% endif %}
            </td>
            <td class="align-middle text-center">
                <span class="badge bg-secondary">{{ pub.item_count }}</span>
            </td>
            <td class="align-middle link-cell">
                {% if pub.possible_matches|length > 0 %}
                    <div class="small mb-1">
                        Possible matches:
                        {% for match in pub.possible_matches %}
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 mb-1 possible-match"
                                    data-company-id="{{ match.id }}"
                                    data-company-label="{{ (match.name ~ ' (' ~ match.publisher_games_count ~ ' game' ~ (match.publisher_games_count != 1 ? 's' : '') ~ ', id: ' ~ match.id ~ ')')|e('html_attr') }}">
                                {{ match.name }} ({{ match.publisher_games_count }} game{{ match.publisher_games_count != 1 ? 's' : '' }}, id: {{ match.id }})
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <div style="width: 260px;">
                        <select class="company-search" style="width: 100%;"></select>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary link-btn" disabled
                            data-link-url="{{ route('staff.games.weekly-updates.list.publishers.link', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}">
                        Link
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary link-alias-btn" disabled>
                        Link and add alias
                    </button>
                </div>
            </td>
            <td class="align-middle action-cell">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <button type="button" class="btn btn-sm btn-success create-btn"
                            data-create-url="{{ route('staff.games.weekly-updates.list.publishers.create', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}">
                        Save as New
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger create-lq-btn"
                            data-create-url="{{ route('staff.games.weekly-updates.list.publishers.create', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}">
                        Save as New (LQ)
                    </button>
                </div>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endif %}

{% if existingPublishers|length > 0 %}
<h2 class="mb-2">Existing publishers</h2>
<table class="table table-sm table-bordered mb-4">
    <thead class="table-dark">
        <tr>
            <th style="width: 35%;">Publisher</th>
            <th style="width: 10%;" class="text-center">This batch</th>
            <th style="width: 10%;" class="text-center">DB games</th>
            <th style="width: 12%;" class="text-center">Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for pub in existingPublishers %}
        <tr class="publisher-row" data-name="{{ pub.name }}" data-status="{{ pub.status }}">
            <td class="align-middle publisher-name-cell">
                {% if pub.company %}
                    <a href="{{ route('staff.games-companies.show', {'gamesCompany': pub.company.id}) }}" target="_blank">{{ pub.via_alias ? pub.company.name : pub.name }}</a>
                    {% if pub.via_alias %}<br><small class="text-muted">From alias "{{ pub.name }}"</small>{% endif %}
                {% else %}
                    {{ pub.name }}
                {% endif %}
            </td>
            <td class="align-middle text-center">
                <span class="badge bg-secondary">{{ pub.item_count }}</span>
            </td>
            <td class="align-middle text-center text-muted small">{{ pub.db_game_count }}</td>
            <td class="align-middle text-center status-cell">
                {% if pub.status == 'lq' %}
                    <span class="badge bg-danger">LQ</span>
                {% else %}
                    <span class="badge bg-success">Known</span>
                {% endif %}
            </td>
            <td class="align-middle action-cell">
                {% if pub.status == 'known' and pub.db_game_count < 10 %}
                    <button type="button" class="btn btn-sm btn-outline-danger mark-lq-btn"
                            data-mark-lq-url="{{ route('staff.games.weekly-updates.list.publishers.mark-lq', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}">
                        Mark batch as LQ
                    </button>
                {% else %}
                    <span class="text-muted small">—</span>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endif %}

{% endif %}

<hr class="mt-2">
{% if newCount is defined and newCount == 0 %}
    <a href="{{ route('staff.games.weekly-updates.list.prices', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}" class="btn btn-success">Continue to Prices →</a>
{% else %}
    <a href="{{ route('staff.games.weekly-updates.list.prices', {'batchId': Batch.id, 'console': Console, 'listType': ListType}) }}" class="btn btn-outline-secondary">
        Continue to Prices → <small>({{ newCount }} publisher{{ newCount != 1 ? 's' : '' }} still to create)</small>
    </a>
{% endif %}

{% endblock page_inner %}

{% block page_body %}
{{ parent() }}
<script>
(function () {
    const CSRF_TOKEN = '{{ csrf_token() }}';

    function doCreate(row, isLq) {
        var input    = row.querySelector('.pub-name-input');
        var oldName  = row.dataset.name;
        var newName  = input ? input.value.trim() : oldName;
        var url      = row.querySelector('.create-btn, .create-lq-btn').dataset.createUrl;

        if (!newName) return;

        var btns = row.querySelectorAll('button');
        btns.forEach(function (b) { b.disabled = true; });

        fetch(url, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': CSRF_TOKEN,
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'old_name=' + encodeURIComponent(oldName) +
                  '&new_name=' + encodeURIComponent(newName) +
                  '&is_lq='    + (isLq ? '1' : '0'),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.status === 'created' || data.status === 'linked') {
                showResult(row, data);
            } else {
                btns.forEach(function (b) { b.disabled = false; });
            }
        })
        .catch(function () {
            btns.forEach(function (b) { b.disabled = false; });
        });
    }

    function doLink(row, addAlias) {
        var select    = row.querySelector('.company-search');
        var companyId = select.value;
        if (!companyId) return;

        var btns = row.querySelectorAll('button');
        btns.forEach(function (b) { b.disabled = true; });

        fetch(row.querySelector('.link-btn').dataset.linkUrl, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': CSRF_TOKEN,
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'old_name=' + encodeURIComponent(row.dataset.name) +
                  '&company_id=' + encodeURIComponent(companyId) +
                  '&add_alias=' + (addAlias ? '1' : '0'),
        })
        .then(function (r) {
            if (!r.ok) throw new Error('Request failed');
            return r.json();
        })
        .then(function (data) { showResult(row, data); })
        .catch(function () {
            btns.forEach(function (b) { b.disabled = false; });
            alert('Could not link that publisher. Reload the page and try again.');
        });
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Say exactly what happened, so a typo can't quietly make a duplicate
    function showResult(row, data) {
        row.dataset.name   = data.name;
        row.dataset.status = data.is_lq ? 'lq' : 'known';

        var link = '<a href="' + data.company_url + '" target="_blank">' + escapeHtml(data.name) + '</a> (id: ' + data.company_id + ')';
        var html = data.status === 'created'
            ? '<span class="badge bg-success">Created</span> ' + link + ', new publisher.'
            : '<span class="badge bg-primary">Linked</span> to ' + link + ', ' + data.game_count + ' game' + (data.game_count == 1 ? '' : 's') + '.';
        if (data.alias_note) html += ' ' + escapeHtml(data.alias_note);
        if (data.is_lq) {
            html += ' <span class="badge bg-danger">LQ</span>';
            if (data.item_count) html += ' ' + data.item_count + ' game' + (data.item_count == 1 ? '' : 's') + ' in this batch marked LQ.';
        }

        row.querySelector('.publisher-name-cell').innerHTML = escapeHtml(row.querySelector('.pub-name-input') ? row.querySelector('.pub-name-input').defaultValue : data.name);
        row.querySelector('.link-cell').innerHTML = html;
        row.querySelector('.link-cell').colSpan = 2;
        row.querySelector('.action-cell').remove();
        if (data.is_lq) row.style.opacity = '0.6';

        updateNewCount();
    }

    function doMarkLq(row) {
        var name = row.dataset.name;
        var url  = row.querySelector('.mark-lq-btn').dataset.markLqUrl;

        if (!confirm('Mark all batch games from "' + name + '" as LQ? This will remove them from the active pipeline.')) return;

        var btn = row.querySelector('.mark-lq-btn');
        btn.disabled = true;
        btn.textContent = 'Saving…';

        fetch(url, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': CSRF_TOKEN,
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'name=' + encodeURIComponent(name),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.status === 'ok') {
                updateRowToLq(row);
            } else {
                btn.disabled = false;
                btn.textContent = 'Mark batch as LQ';
            }
        })
        .catch(function () {
            btn.disabled = false;
            btn.textContent = 'Mark batch as LQ';
        });
    }

    function updateRowToLq(row) {
        row.dataset.status = 'lq';
        var statusCell = row.querySelector('.status-cell');
        if (statusCell) statusCell.innerHTML = '<span class="badge bg-danger">LQ</span>';
        row.querySelector('.action-cell').innerHTML = '<span class="text-muted small">—</span>';
        row.style.opacity = '0.5';
    }

    function updateNewCount() {
        var remaining = document.querySelectorAll('.publisher-row[data-status="new"]').length;
        var continueBtn = document.querySelector('a.btn-success, a.btn-outline-secondary');
        if (!continueBtn) return;
        if (remaining === 0) {
            continueBtn.className = continueBtn.className.replace('btn-outline-secondary', 'btn-success');
            continueBtn.innerHTML = 'Continue to Prices →';
        }
    }

    function attachMarkLqHandler(btn) {
        btn.addEventListener('click', function () {
            doMarkLq(btn.closest('tr'));
        });
    }

    // Attach create handlers
    document.querySelectorAll('.create-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            doCreate(btn.closest('tr'), false);
        });
    });

    document.querySelectorAll('.create-lq-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            doCreate(btn.closest('tr'), true);
        });
    });

    // Attach mark-LQ handlers
    document.querySelectorAll('.mark-lq-btn').forEach(attachMarkLqHandler);

    // ---- Link to an existing publisher ----
    // The same company search as the game partners page
    $('.company-search').select2({
        placeholder: 'Search for a publisher',
        minimumInputLength: 2,
        allowClear: true,
        templateResult: function (partner) {
            return partner.loading ? partner.text : (partner.name || partner.text);
        },
        templateSelection: function (partner) {
            return partner.name ? partner.name + ' (id: ' + partner.id + ')' : partner.text;
        },
        ajax: {
            url: '/api/partner/games-company/search',
            dataType: 'json',
            data: function (params) { return { name: params.term }; },
            processResults: function (data) { return { results: data.partners }; }
        }
    }).on('change', function () {
        var row = this.closest('tr');
        var picked = !!this.value;
        row.querySelector('.link-btn').disabled = !picked;
        row.querySelector('.link-alias-btn').disabled = !picked;
    });

    // A possible match picks that company in the search box
    document.querySelectorAll('.possible-match').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var select = btn.closest('tr').querySelector('.company-search');
            var option = new Option(btn.dataset.companyLabel, btn.dataset.companyId, true, true);
            $(select).empty().append(option).trigger('change');
        });
    });

    document.querySelectorAll('.link-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { doLink(btn.closest('tr'), false); });
    });
    document.querySelectorAll('.link-alias-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { doLink(btn.closest('tr'), true); });
    });
})();
</script>
{% endblock page_body %}
