{% extends 'theme/staff-b5/layout-default.twig' %}

{% import "ui/components/headings/heading.twig" as heading %}
{% import 'ui/components/table/row-link-stat.twig' as rowstat %}

{% block page_inner %}

{% if session('goToGameError') %}
    <div class="alert alert-danger">{{ session('goToGameError') }}</div>
{% endif %}

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <a href="{{ route('staff.games.add') }}" class="btn outline btn-primary">Add a game</a>
    <a href="{{ route('staff.games.single-game-add.show') }}" class="btn outline btn-primary">Add a game from the store</a>

    <div class="d-flex flex-wrap gap-2 ms-md-auto">
        <form method="post" action="{{ route('staff.games.search') }}" class="d-flex gap-2">
            {{ csrf_field() }}
            <input type="search" name="search_keywords" class="form-control" placeholder="Search games" minlength="3" required aria-label="Search games">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
        <form method="get" action="{{ route('staff.games.goToGame') }}" class="d-flex gap-2">
            <input type="number" name="game_id" class="form-control" placeholder="Game ID" min="1" required aria-label="Game ID" style="width: 8rem;">
            <button type="submit" class="btn btn-outline-secondary">Go</button>
        </form>
    </div>
</div>

<div class="row">

    <div class="col-md-4">

        {{ heading.renderSlick('Weekly updates') }}

        <table class="table">
            <tbody>
            <tr>
                <td>
                    <a href="{{ route('staff.games.weekly-updates.index')}}">Weekly updates</a>
                </td>
                <td class="text-end">
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.release-hub.show')}}">Release hub</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.games.release-hub.show')}}" class="h4"></a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.images.dashboard')}}">Game images</a>
                </td>
                <td class="text-end">
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.gameGroup.index')}}">Game groups</a>
                    (<a href="{{ route('staff.games.gameGroup.suggestions')}}">suggestions</a>)
                </td>
                <td class="text-end">
                </td>
            </tr>
            </tbody>
        </table>

        {{ heading.renderSlick('Missing data') }}

        <table class="table">
            <tbody>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-nintendo-co-uk-link'}) }}">No Nintendo.co.uk link</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-nintendo-co-uk-link'}) }}" class="h4">{{ NoNintendoCoUkLinkCount }}</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'broken-nintendo-co-uk-link'}) }}">Broken Nintendo.co.uk link</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.games.list.showList', {'listType': 'broken-nintendo-co-uk-link'}) }}" class="h4">{{ BrokenNintendoCoUkLinkCount }}</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-eu-release-date'}) }}">No EU release date</a>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-eshop-price'}) }}">No price</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-eshop-price'}) }}" class="h4">{{ NoPriceCount }}</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-video-type'}) }}">No video type</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-video-type'}) }}" class="h4">{{ MissingVideoTypeCount }}</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-amazon-uk-link'}) }}">No Amazon UK link</a>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td>
                    Missing players
                </td>
                <td class="text-end">
                    <span class="h4">{{ MissingPlayersCount }}</span>
                </td>
            </tr>
            </tbody>
        </table>

        {{ heading.renderSlick('Verification') }}

        <table class="table">
            <tbody>
                {{ rowstat.renderB5(
                    'Category: Unverified', null, CategoryUnverified
                ) }}
                {{ rowstat.renderB5(
                    'Category: Verified', null, CategoryVerified
                ) }}
                {{ rowstat.renderB5(
                    'Category: Needs review', null, CategoryNeedsReview
                ) }}
            </tbody>
        </table>

    </div>

    <div class="col-md-4">

        {{ heading.renderSlick('Subpages') }}
        <table class="table">
            <tbody>
                {{ rowstat.renderB5(
                    'Games stats', route('staff.games.stats')
                ) }}
                {{ rowstat.renderB5(
                    'Affiliates', route('staff.games.affiliates')
                ) }}
            </tbody>
        </table>

        {{ heading.renderSlick('Lists') }}
        <table class="table">
            <tbody>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'recently-added'}) }}">Recently added</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'recently-released'}) }}">Recently released</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'upcoming-games'}) }}">Upcoming games</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.flag.index') }}">By flag</a>
                </td>
            </tr>
            </tbody>
        </table>

        {{ heading.renderSlick('Admin tools') }}
        <table class="table">
            <tbody>
            <tr>
                <td>
                    <a href="{{ route('staff.games.search') }}">Search</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.featured-games.list') }}">Featured games</a>
                </td>
            </tr>
            </tbody>
        </table>

        {{ heading.renderSlick('Archive') }}
        <table class="table">
            <tbody>
            <tr>
                <td>
                    <a href="{{ route('staff.games.title-hash.list') }}">All title hashes</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.json-import.upload')}}">Import games from JSON</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'upcoming-eshop-crosscheck'}) }}">Upcoming (eShop crosscheck)</a>
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="col-md-4">

        {% include 'staff/games/partials/game-status-stats.twig' %}

        {{ heading.renderSlick('Crawl lifecycle') }}

        <table class="table">
            <tbody>
            {{ rowstat.renderB5(
                'Not yet crawled', null, CrawlNotYetCrawled
            ) }}
            {{ rowstat.renderB5(
                '200 - OK', null, CrawlStatus200
            ) }}
            {{ rowstat.renderB5(
                '404 - Not found', route('staff.games.list.showList', {'listType': 'crawl-status-404'}), CrawlStatus404
            ) }}
            {{ rowstat.renderB5(
                '410 - Gone', route('staff.games.list.showList', {'listType': 'crawl-status-410'}), CrawlStatus410
            ) }}
            {{ rowstat.renderB5(
                '3xx - Redirect', route('staff.games.list.showList', {'listType': 'crawl-status-redirect'}), CrawlStatusRedirect
            ) }}
            {{ rowstat.renderB5(
                '5xx - Server error', route('staff.games.list.showList', {'listType': 'crawl-status-error'}), CrawlStatusError
            ) }}
            </tbody>
        </table>

    </div>

</div>

{% endblock page_inner %}
