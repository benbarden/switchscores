{% extends 'theme/staff-b5/layout-default.twig' %}
{% import 'ui/components/game/packshots.twig' as packshots %}
{% import 'ui/components/links/game.twig' as gamelink %}
{% import 'ui/components/game/console-badge.twig' as consolebadge %}
{% import 'ui/components/staff/dashboard-tile.twig' as dashtile %}

{% block page_inner %}

{# Needs attention (#163, Phase 1). Tiles are already filtered by role in AttentionTiles.
   Queues to clear on the left (2/3), site health on the right (1/3). #}
{% set queueTiles = AttentionTiles|filter(t => t.group == 'queue') %}
{% set healthTiles = AttentionTiles|filter(t => t.group == 'health') %}
{% if AttentionTiles|length > 0 %}
<section class="ss-dash">
    <div class="ss-dash__grid{% if healthTiles|length == 0 or queueTiles|length == 0 %} ss-dash__grid--single{% endif %}">
        {% if queueTiles|length > 0 %}
            <div>
                <h2 class="ss-dash__h">Needs attention</h2>
                <div class="ss-tiles ss-tiles--2">
                    {% for tile in queueTiles %}
                        {{ dashtile.render(tile) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        {% if healthTiles|length > 0 %}
            <div>
                <h2 class="ss-dash__h">Site health</h2>
                <div class="ss-tiles ss-tiles--1">
                    {% for tile in healthTiles %}
                        {{ dashtile.render(tile) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endif %}

<div class="row">

    <div class="col-md-4">

        {% if auth_user().hasRole('Games manager') or auth_user().isOwner() %}
            <h2 class="ss-h2">Games to add</h2>

            <table class="table ss-table">
                <tbody>
                <tr>
                    <td>
                        <a href="{{ route('staff.games.weekly-updates.index')}}">Weekly updates</a>
                    </td>
                    <td class="text-end">
                    </td>
                </tr>
                <tr>
                    <td>
                        <a href="{{ route('staff.games.release-hub.show')}}">Release hub</a>
                    </td>
                    <td class="text-end">
                    </td>
                </tr>
                </tbody>
            </table>
        {% endif %}

        <h2 class="ss-h2">Nintendo links</h2>

        <table class="table ss-table">
            <tbody>
            {% if auth_user().hasRole('Data source manager') or auth_user().isOwner() %}
                <tr>
                    <td>
                        <a href="{{ route('staff.data-sources.nintendo-co-uk.unlinked') }}">Nintendo.co.uk API: Unlinked items</a>
                    </td>
                    <td class="text-end">
                        <a href="{{ route('staff.data-sources.nintendo-co-uk.unlinked') }}" class="h4">{{ NintendoCoUkUnlinkedCount }}</a>
                    </td>
                </tr>
            {% endif %}
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-nintendo-co-uk-link'}) }}">No Nintendo.co.uk link</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-nintendo-co-uk-link'}) }}" class="h4">{{ NoNintendoCoUkLinkCount }}</a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'broken-nintendo-co-uk-link'}) }}">Broken Nintendo.co.uk link</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.games.list.showList', {'listType': 'broken-nintendo-co-uk-link'}) }}" class="h4">{{ BrokenNintendoCoUkLinkCount }}</a>
                </td>
            </tr>
            </tbody>
        </table>

    </div>

    <div class="col-md-4">

        <h2 class="ss-h2">Missing data</h2>

        <table class="table ss-table">
            <tbody>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-category-excluding-low-quality'}) }}">
                        No category (Excluding low quality)
                    </a>
                </td>
                <td class="text-end">
                    <span class="h4">{{ NoCategoryExcludingLowQualityCount }}</span>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.games.list.showList', {'listType': 'no-category-all'}) }}">
                        No category (All)
                    </a>
                </td>
                <td class="text-end">
                    <span class="h4">{{ NoCategoryAllCount }}</span>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.partners.data-cleanup.games-with-missing-publisher') }}">Games with missing publisher</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.partners.data-cleanup.games-with-missing-publisher') }}" class="h4">{{ PublisherMissingCount }}</a>
                </td>
            </tr>
            </tbody>
        </table>

    </div>

    <div class="col-md-4">

        <h2 class="ss-h2">Registration</h2>
        <table class="table ss-table">
            <tbody>
            {% if auth_user().isOwner() %}
                <tr>
                    <td>
                        <a href="{{ route('owner.user.list') }}">Registered users</a>
                    </td>
                    <td class="text-end">
                        <a href="{{ route('owner.user.list') }}" class="h4">{{ RegisteredUserCount }}</a>
                    </td>
                </tr>
            {% endif %}
            <tr>
                <td>
                    <a href="{{ route('staff.invite-code.list') }}">Invite codes</a>
                </td>
                <td></td>
            </tr>
            <tr>
                <td>
                    <a href="{{ route('staff.unverified-members.index') }}">Unverified members</a>
                </td>
                <td class="text-end">
                    <a href="{{ route('staff.unverified-members.index') }}" class="h4">{{ UnverifiedMemberCount }}</a>
                </td>
            </tr>
            </tbody>
        </table>

    </div>

</div>

{# Crawl queue and recently added: 5 each, smaller (#163, decision 2) #}
{% if auth_user().hasRole('Games manager') or auth_user().isOwner() %}
<div class="row">

    <div class="col-md-6">
        {% if CrawlPriorityQueue.count > 0 %}
            {% set crawlTitle = 'Crawl priority queue' %}
            {% set crawlItems = CrawlPriorityQueue %}
        {% elseif NextToCrawl is defined and NextToCrawl.count > 0 %}
            {% set crawlTitle = 'Next to crawl' %}
            {% set crawlItems = NextToCrawl %}
        {% else %}
            {% set crawlTitle = 'Crawl queue' %}
            {% set crawlItems = [] %}
        {% endif %}

        <h2 class="ss-h2">{{ crawlTitle }}</h2>
        {% if crawlItems|length > 0 %}
            <ul class="ss-mini">
                {% for item in crawlItems %}
                    <li>
                        <span class="ss-mini__img">{{ packshots.square(item) }}</span>
                        <span class="ss-mini__body">
                            {{ consolebadge.short(item) }}
                            {{ gamelink.title(item, 'staff') }}
                            <small>
                                {% if item.last_crawled_at %}
                                    Last crawled {{ item.last_crawled_at|date('d M Y') }}
                                {% else %}
                                    Never crawled
                                {% endif %}
                                {% if item.is_low_quality == 1 %}
                                    &middot; <span class="badge bg-danger">Low quality</span>
                                {% endif %}
                            </small>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted small">No games to crawl.</p>
        {% endif %}
    </div>

    <div class="col-md-6">
        <h2 class="ss-h2">Recently added</h2>
        {% if RecentlyAddedGames.count > 0 %}
            <ul class="ss-mini">
                {% for item in RecentlyAddedGames %}
                    <li>
                        <span class="ss-mini__img">{{ packshots.square(item) }}</span>
                        <span class="ss-mini__body">
                            {{ consolebadge.short(item) }}
                            {{ gamelink.title(item, 'staff') }}
                            <small>
                                Added {{ item.created_at|date('d M @ H:i') }}
                                {% if item.is_low_quality == 1 %}
                                    &middot; <span class="badge bg-danger">Low quality</span>
                                {% endif %}
                            </small>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted small">No items found.</p>
        {% endif %}
        <p class="small"><a href="{{ route('staff.games.list.showList', {'listType': 'recently-added'}) }}">View all recently added games</a></p>
    </div>

</div>
{% endif %}

{% endblock page_inner %}
