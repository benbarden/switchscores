{% extends 'theme/staff-b5/layout-default.twig' %}

{% block page_inner %}

<div class="row">

    <div class="col-md-12">

        {% if ReviewSitesArray %}

            <table class="table data-sortable">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th class="text-center">Review total</th>
                        <th class="text-center">Review share</th>
                        <th class="text-center">Games reviewed</th>
                        <th class="text-center">Latest review</th>
                    </tr>
                </thead>
                <tbody>
                {% for item in ReviewSitesArray %}
                    <tr>
                        <td>
                            <a href="{{ route('partners.review-sites.siteProfile', {'linkTitle': item.link_title}) }}" target="_blank">
                                {{ item.name }}
                            </a>
                        </td>
                        <td class="text-center">
                            {{ item.review_count }}
                        </td>
                        <td class="text-center">
                            {{ item.review_link_contrib_total }}%
                        </td>
                        <td class="text-center">
                            {{ item.review_game_completion_total }}%
                        </td>
                        <td class="text-center">
                            {{ item.latest_review_date }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

        {% endif %}

    </div>

</div>

{% endblock page_inner %}
