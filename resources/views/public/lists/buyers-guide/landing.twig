{% extends 'theme/wos/base.twig' %}

{% block page_body %}

<style>
    .bg-region-card {
        display: block;
        padding: 24px;
        margin-bottom: 24px;
        border: 2px solid #ddd;
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
    }
    .bg-region-card:hover,
    .bg-region-card:focus {
        border-color: #337ab7;
        color: inherit;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }
    .bg-region-card h2 {
        margin-top: 0;
    }
    .bg-region-card .bg-region-store {
        color: #666;
        margin-bottom: 16px;
    }
</style>

<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <p>
            The best Nintendo Switch 2 and Switch games to buy, picked from the highest-rated games on
            Switch Scores, plus consoles and accessories.
        </p>
        {% include 'public/lists/buyers-guide/_updated.twig' %}
        <p>Choose your region, so the links go to the right Amazon store.</p>
    </div>
</div>

<div class="row">
    <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
        <a href="{{ route('buyersGuide.region', {'region': 'us'}) }}" class="bg-region-card">
            <h2>United States</h2>
            <p class="bg-region-store">Links to Amazon.com</p>
            <span class="btn btn-primary">See the US guide</span>
        </a>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
        <a href="{{ route('buyersGuide.region', {'region': 'uk'}) }}" class="bg-region-card">
            <h2>United Kingdom</h2>
            <p class="bg-region-store">Links to Amazon.co.uk</p>
            <span class="btn btn-primary">See the UK guide</span>
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <h2>What's in the guide</h2>
        <ul>
            <li><strong>Consoles and accessories</strong> - Nintendo Switch 2, controllers, storage and more.</li>
            <li><strong>Top Nintendo Switch 2 games</strong> - the best-rated games for the new console.</li>
            <li><strong>Top Nintendo Switch games</strong> - all-time favourites, most of which also play on Switch 2.</li>
        </ul>
        <p>
            Games are picked using the Switch Scores rankings, which average review scores from
            across the web.
        </p>
    </div>
</div>

{% endblock page_body %}
